# jira-lean configuration. Copy to a private location (never commit the real file),
# fill in, and point JIRA_LEAN_ENV_FILE at it — or set these variables directly in
# your MCP client's server config. Real environment variables override this file.

# Your Atlassian Cloud site.
ATLASSIAN_SITE=https://your-company.atlassian.net

# The account that owns the API token.
ATLASSIAN_EMAIL=you@example.com

# Classic API token from https://id.atlassian.com/manage-profile/security/api-tokens
ATLASSIAN_API_TOKEN=paste-your-token-here

# Optional
# JIRA_LEAN_READ_ONLY=false
# JIRA_LEAN_DEFAULT_FIELDS=summary,status,issuetype,assignee,priority,updated
# JIRA_LEAN_TIMEOUT=30
